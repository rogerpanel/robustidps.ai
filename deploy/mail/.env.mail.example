# Copy to deploy/mail/.env.mail and fill in. Never commit the real file.

MAIL_HOSTNAME=mail.robustidps.ai
POSTMASTER_ADDRESS=admin@robustidps.ai

# ── Optional outbound relay ────────────────────────────────────────────
# Hetzner blocks outbound port 25 until support unblocks it. A relay on
# port 587 lets you send today and also carries a warm IP reputation, so
# mail lands in Gmail/Outlook inboxes from day one. Leave RELAY_HOST
# empty to send direct once port 25 is open and the IP has warmed up.
#
#   SMTP2GO  (free 1,000 msgs/month):  mail.smtp2go.com  587   spf: include:spf.smtp2go.com
#   Brevo    (free 300 msgs/day):      smtp-relay.brevo.com 587 spf: include:spf.brevo.com
#   Amazon SES (~$0.10 / 1,000):       email-smtp.eu-north-1.amazonaws.com 587  spf: include:amazonses.com
#
# Whichever you pick, add its "include:" to the SPF record (see README).
RELAY_HOST=
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=

# Seconds to wait for the ACME DNS challenge record to propagate before
# Let's Encrypt validates it. 60 is a safe default for Cloudflare.
ACME_PROPAGATION_SECONDS=60
