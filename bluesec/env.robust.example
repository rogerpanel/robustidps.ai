# Add these lines to the reference agent's .env (keep its SCENARIO_RUNTIME_* lines).
# Never commit .env.

# Shown next to your runs on the leaderboard.
AGENT_NAME=robustidps-agent
REMOTE_RUN_LABEL=robustidps-agent

# Which model drives the investigation: anthropic | openai
ROBUST_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = better reasoning, slower, costlier)
ANTHROPIC_EFFORT=high

# For ROBUST_PROVIDER=openai, the reference variables are used instead:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-with-your-key
# LLM_DEFAULT_MODEL=deepseek-chat

# Investigation limits.
# Past the soft budget the agent is told to wrap up; past the hard cap, evidence
# calls are refused locally so it must submit. Traces: one JSON per task plus
# summary.json per run.
ROBUST_SOFT_BUDGET=12
ROBUST_MAX_TOOL_CALLS=30
ROBUST_MAX_TURNS=45
ROBUST_TRACE_DIR=traces
