{
  "id": "soc-triage",
  "version": "5",
  "name": "SOC alert triage",
  "description": "Investigation queries run freely, notes and tickets are allowed, reversible containment needs an analyst's approval, irreversible actions and shell access are denied. Targets are judged by type, never by the names attackers choose. With an asset inventory (Environment tab), containment is also checked against its predicted effect: it is denied if a redundancy group would fall below its minimum or too many dependents would be cut off; service effects matched by process name or path go to a person instead. Information flow: alerts, logs, e-mails and attachments are both attacker-influenced and internal, so once a session has read them, sending data outside the organisation (e-mail, webhooks, public sandboxes, unclassified services) goes to a person; messages to internal destinations (Environment tab) are allowed. Network containment targets are read as values: at most 256 addresses per action (so 10.0.0.0/8 or 0.0.0.0/1 is denied like *), wildcard domains only below a registered domain, numeric IP addresses in disguised forms (hex, integer) are denied, and targets that cannot be read go to a person.",
  "default_tier": "unknown",
  "tiers": {
    "read": {
      "decision": "allow",
      "description": "Queries and lookups that change nothing",
      "reversible": true
    },
    "annotate": {
      "decision": "allow",
      "description": "Notes, tags, tickets, verdict submission",
      "reversible": true
    },
    "notify": {
      "decision": "allow",
      "description": "Messages and notifications; sends outside the organisation are checked by the information-flow rules",
      "reversible": false
    },
    "contain_reversible": {
      "decision": "ask",
      "description": "Containment an analyst can undo (isolate, block, disable)",
      "reversible": true
    },
    "contain_irreversible": {
      "decision": "deny",
      "description": "Deletes, wipes, reimages and arbitrary command execution",
      "reversible": false
    },
    "unknown": {
      "decision": "ask",
      "description": "Tools this pack does not classify"
    }
  },
  "tools": [
    {
      "match": [
        "search*",
        "get_*",
        "list_*",
        "query*",
        "lookup*",
        "describe*",
        "enrich*",
        "fetch_alert*",
        "read_*"
      ],
      "tier": "read"
    },
    {
      "match": [
        "add_note*",
        "comment*",
        "tag_*",
        "create_ticket*",
        "update_ticket*",
        "assign*",
        "finish_investigation",
        "submit*"
      ],
      "tier": "annotate"
    },
    {
      "match": [
        "send_*",
        "email_*",
        "forward_*",
        "notify*",
        "post_*",
        "reply_*"
      ],
      "tier": "notify"
    },
    {
      "match": [
        "isolate*",
        "unisolate*",
        "quarantine*",
        "block_*",
        "unblock_*",
        "disable_account*",
        "enable_account*",
        "suspend*",
        "kill_process*",
        "revoke_session*",
        "reset_password*"
      ],
      "tier": "contain_reversible"
    },
    {
      "match": [
        "delete*",
        "wipe*",
        "reimage*",
        "purge*",
        "drop_*",
        "shred*",
        "shell*",
        "bash*",
        "exec*",
        "run_command*",
        "powershell*"
      ],
      "tier": "contain_irreversible"
    }
  ],
  "arg_rules": [
    {
      "id": "mass-target",
      "description": "Containment aimed at everything at once",
      "tools": [
        "isolate*",
        "quarantine*",
        "block_*",
        "disable_account*",
        "kill_process*",
        "suspend*",
        "revoke_session*",
        "reset_password*"
      ],
      "args": [
        "host*",
        "ip*",
        "target*",
        "user*",
        "account*",
        "cidr*",
        "indicator*"
      ],
      "pattern": "^\\s*(\\*|all|any|everyone|0\\.0\\.0\\.0/0|::/0)\\s*$",
      "decision": "deny"
    }
  ],
  "clamps": [
    {
      "id": "result-cap",
      "tools": [
        "search*",
        "query*",
        "list_*"
      ],
      "arg": "limit",
      "max": 500
    },
    {
      "id": "result-cap-max",
      "tools": [
        "search*",
        "query*",
        "list_*"
      ],
      "arg": "max_results",
      "max": 500
    }
  ],
  "redact": [
    {
      "id": "no-secrets-in-args",
      "args": [
        "password",
        "passwd",
        "secret*",
        "api_key",
        "apikey",
        "token",
        "*_token",
        "private_key"
      ]
    }
  ],
  "max_calls_per_session": 200,
  "escalate_after_denials": 3,
  "hint_tiers": {
    "read": "read",
    "change": "contain_reversible",
    "destroy": "contain_irreversible",
    "exec": "contain_irreversible",
    "unclear": "unknown"
  },
  "budgets": [
    {
      "id": "containment-budget",
      "description": "Containment actions per session",
      "tools": [
        "isolate*",
        "quarantine*",
        "block_*",
        "disable_account*",
        "kill_process*",
        "suspend*",
        "revoke_session*",
        "reset_password*"
      ],
      "max_total": 10,
      "when_exhausted": "deny"
    }
  ],
  "predictive": {
    "effects": [
      {
        "tools": [
          "isolate*",
          "unisolate*"
        ],
        "makes_unavailable": "host",
        "on_violation": "deny"
      },
      {
        "tools": [
          "disable_account*",
          "revoke_session*",
          "reset_password*",
          "suspend*"
        ],
        "makes_unavailable": "account",
        "on_violation": "deny"
      },
      {
        "tools": [
          "block_ip*"
        ],
        "makes_unavailable": "ip",
        "on_violation": "deny"
      },
      {
        "tools": [
          "block_domain*"
        ],
        "makes_unavailable": "domain",
        "on_violation": "deny"
      },
      {
        "tools": [
          "kill_process*",
          "quarantine_file*",
          "quarantine*"
        ],
        "makes_unavailable": "service",
        "on_violation": "ask"
      }
    ],
    "max_blast_radius": 100,
    "max_session_blast_radius": 250,
    "unknown_target": "ask"
  },
  "flow": {
    "labels": [
      {
        "label": "untrusted",
        "description": "Content an outsider can influence: alerts, logs, e-mails, attachments, web pages, threat-intel results",
        "tools": [
          "fetch_alert*",
          "get_alert*",
          "list_alerts*",
          "search*",
          "query*",
          "get_email*",
          "read_email*",
          "get_attachment*",
          "fetch_url*",
          "get_url*",
          "get_sandbox_report*",
          "enrich*"
        ]
      },
      {
        "label": "sensitive",
        "description": "Internal or private data: telemetry, user and identity records, mailbox content, internal files, secrets",
        "tools": [
          "fetch_alert*",
          "get_alert*",
          "list_alerts*",
          "search*",
          "query*",
          "get_user*",
          "lookup_user*",
          "list_users*",
          "*identity*",
          "get_mailbox*",
          "get_email*",
          "read_email*",
          "get_attachment*",
          "get_file*",
          "download_file*",
          "*credential*",
          "*secret*",
          "get_customer*"
        ]
      },
      {
        "label": "egress",
        "description": "Sends data outside the organisation; destinations in the Environment tab's internal list are exempt",
        "tools": [
          "send_*",
          "email_*",
          "forward_*",
          "reply_*",
          "post_*",
          "*webhook*",
          "share_*",
          "publish*",
          "upload*",
          "submit_to_sandbox*",
          "submit_sample*",
          "submit_file*",
          "submit_url*",
          "notify_external*"
        ],
        "destination_args": [
          "to",
          "cc",
          "bcc",
          "recipient*",
          "url",
          "destination*",
          "channel",
          "webhook*",
          "endpoint"
        ]
      }
    ],
    "rules": [
      {
        "id": "rule-of-two",
        "description": "Sending data out after the session read untrusted input and sensitive data",
        "sink": "egress",
        "requires": [
          "untrusted",
          "sensitive"
        ],
        "on_violation": "ask"
      }
    ],
    "unclassified": [
      "untrusted",
      "sensitive",
      "egress"
    ]
  },
  "actions": [
    {
      "id": "containment-targets",
      "description": "Network containment aimed at a bounded, readable set of hosts",
      "tools": [
        "isolate*",
        "unisolate*",
        "block_ip*",
        "unblock_ip*",
        "block_cidr*",
        "block_domain*",
        "unblock_domain*"
      ],
      "target_args": [
        "host",
        "hosts",
        "ip",
        "ips",
        "cidr",
        "target",
        "targets",
        "domain",
        "domains"
      ],
      "max_targets": 256,
      "on_exceed": "deny",
      "wildcard_hosts": true,
      "require_targets": true,
      "unparseable": "ask",
      "split_spaces": false
    }
  ]
}
